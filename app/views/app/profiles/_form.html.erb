<%= form_with(model: customer, url: app_profile_path, class: "gl-form") do |form| %>

  <% if customer.errors.any? %>
    <div id="error_explanation" class="gl-form-errors" role="alert">
      <h2 class="gl-form-errors-title"><%= pluralize(customer.errors.count, "error") %> prohibited your profile from being saved:</h2>

      <ul class="gl-form-errors-list">
        <% customer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="gl-form-grid gl-form-grid-two">
    <div class="gl-form-field">
      <%= form.label :first_name, class: "gl-form-label" %>
      <%= form.text_field :first_name, autocomplete: "given-name", class: ["gl-input", customer.errors[:first_name].any? ? "gl-input-error" : nil] %>
    </div>
    <div class="gl-form-field">
      <%= form.label :last_name, class: "gl-form-label" %>
      <%= form.text_field :last_name, autocomplete: "family-name", class: ["gl-input", customer.errors[:last_name].any? ? "gl-input-error" : nil] %>
    </div>
  </div>

  <%= render "customers/form/telephone", form: form, attribute: :cellphone, model: customer.cellphone %>
  <%= render "customers/form/email", form: form, attribute: :email, model: customer.email %>
  
  <% if customer.errors[:first_name].include?("and last name already exists") %>
    <%= form.hidden_field :skip_unique_name_validation, value: true %>
    <%= form.submit "Create anyway?", class: "gl-submit" %>
  <% end %>

  <div class="gl-form-actions">
    <%= form.submit "Update Profile", class: "gl-submit" %>
  </div>
<% end %>
