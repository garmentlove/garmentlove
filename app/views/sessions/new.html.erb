<section class="gl-page">
  <div class="gl-page-header">
    <div>
      <p class="gl-eyebrow">Welcome back</p>
      <h1 class="gl-page-title">Sign in to GarmentLove</h1>
      <p class="gl-page-description">We'll email you a one-time sign-in code.</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <p role="status"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p role="alert"><%= flash[:alert] %></p>
  <% end %>

  <div class="gl-card">
    <h2>Get a sign-in code</h2>
    <%= form_with url: session_path, class: "gl-form" do |form| %>
      <div class="gl-form-field">
        <%= form.label :sign_in, "Username, Email, or Phone Number", class: "gl-form-label" %>
        <%= form.text_field :sign_in, required: true, autocomplete: "username", class: "gl-input" %>
      </div>
      <%= form.submit "Send me a code", class: "gl-submit" %>
    <% end %>
  </div>
</section>
