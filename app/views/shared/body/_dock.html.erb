<% customers_active = controller_name == "customers" %>
<% orders_active = controller_name == "orders" %>

<nav class="gl-dock" aria-label="Workspace navigation">
  <span class="gl-dock-link gl-dock-link-disabled" aria-disabled="true">
    <svg class="gl-dock-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="M4 4h6v6H4zM14 4h6v4h-6zM14 12h6v8h-6zM4 14h6v6H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>
    <span>Dashboard</span>
  </span>

  <%= link_to new_order_path, class: [ "gl-dock-link", ("gl-dock-link-active" if orders_active) ], aria: (orders_active ? { current: "page" } : {}) do %>
    <svg class="gl-dock-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5h16l-1.5 14h-13z" />
      <path d="M9 9h6M9 13h6" />
      <path d="M8 5a4 4 0 0 1 8 0" />
    </svg>
    <span>New order</span>
  <% end %>

  <%= link_to customers_path, class: [ "gl-dock-link", ("gl-dock-link-active" if customers_active) ], aria: (customers_active ? { current: "page" } : {}) do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="gl-dock-icon" aria-hidden="true"  width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-users">
      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
      <path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
      <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
    </svg>
    <span>Customers</span>
  <% end %>
</nav>
