<% content_for :title, "Customer directory" %>

<section class="gl-page">
  <% if notice.present? %>
    <p class="gl-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="gl-page-heading">
    <div>
      <p class="gl-eyebrow">Workspace / Directory</p>
      <h1 class="gl-title">Customers</h1>
      <p class="gl-subtitle">A clear view of the people behind every great fit.</p>
    </div>
    <%= link_to new_customer_path, class: "gl-button" do %>
      <span aria-hidden="true" class="gl-mark-plus">+</span>
      New customer
    <% end %>
  </div>

  <div class="gl-summary-list">
    <div class="gl-summary-card">
      <p class="gl-summary-label">Total customers</p>
      <p class="gl-summary-value"><%= @customers.size %></p>
    </div>
    <div class="gl-summary-card">
      <p class="gl-summary-label">Leads</p>
      <p class="gl-summary-value gl-accent-text"><%= @customers.count(&:lead?) %></p>
    </div>
  </div>

  <div id="customers" class="gl-directory">
    <% if @customers.any? %>
      <div class="gl-directory-heading">
        <span>Customer</span>
        <span>Contact</span>
        <span>Type</span>
        <span>Actions</span>
      </div>
      <div>
        <% @customers.each do |customer| %>
          <article class="gl-customer-row">
            <%= render customer %>

            <div class="gl-contact">
              <% if customer.email&.address.present? %>
                <p class="gl-contact-primary"><%= customer.email.address %></p>
              <% else %>
                <p class="gl-contact-muted">No email on file</p>
              <% end %>
              <% if customer.cellphone&.number.present? %>
                <p class="gl-contact-secondary"><%= customer.cellphone.number %></p>
              <% end %>
            </div>

            <div>
              <span class="gl-badge"><%= customer.customer_type %></span>
            </div>

            <div class="gl-actions">
              <%= link_to "View", customer, class: "gl-action-link" %>
              <%= link_to "Edit", edit_customer_path(customer), class: "gl-action-link" %>
              <%= button_to "Delete", customer, method: :delete, form_class: "gl-destructive-form", class: "gl-button-danger", data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="gl-empty-state">
        <div class="gl-empty-mark" aria-hidden="true">GL</div>
        <h2 class="gl-empty-title">Your directory is ready</h2>
        <p class="gl-empty-copy">Add your first customer to keep their contact details and account information close at hand.</p>
        <%= link_to "Add your first customer", new_customer_path, class: "gl-empty-action" %>
      </div>
    <% end %>
  </div>
</section>
