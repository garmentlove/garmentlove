<div id="<%= dom_id customer %>" class="gl-customer-identity">
  <div class="gl-avatar">
    <%= customer.initials %>
  </div>
  <div class="gl-identity-copy">
    <h2 class="gl-customer-name"><%= customer.name.presence || "Unnamed customer" %></h2>
    <p class="gl-caption">Customer since <%= customer.created_at.strftime("%b %Y") %></p>
  </div>
</div>
