<% content_for :title, @customer.name.presence || "Customer account" %>

<section class="gl-page gl-page-wide">
  <% if notice.present? %>
    <p class="gl-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="gl-page-heading">
    <%= link_to customers_path, class: "gl-link-back" do %>
      <span aria-hidden="true">←</span>
      Customer directory
    <% end %>
    <div class="gl-action-bar">
      <%= link_to "Edit account", edit_customer_path(@customer), class: "gl-button-secondary" %>
      <%= button_to "Delete", @customer, method: :delete, form_class: "gl-destructive-form", class: "gl-button-danger", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="gl-account-card">
    <div class="gl-account-hero">
      <div class="gl-account-glow" aria-hidden="true"></div>
      <div class="gl-account-identity">
        <div class="gl-avatar gl-avatar-large"><%= @customer.initials %></div>
        <div class="gl-identity-copy">
          <p class="gl-eyebrow">Customer account</p>
          <h1 class="gl-account-title"><%= @customer.name.presence || "Unnamed customer" %></h1>
          <div class="gl-account-meta">
            <span class="gl-badge"><%= @customer.customer_type %></span>
            <span>Added <%= @customer.created_at.strftime("%B %-d, %Y") %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="gl-account-grid">
      <section class="gl-detail-card">
        <h2 class="gl-detail-title">Contact details</h2>
        <dl class="gl-detail-list">
          <div>
            <dt class="gl-detail-label">Email</dt>
            <dd class="gl-detail-value gl-detail-value-break"><%= @customer.email&.address.presence || "Not provided" %></dd>
          </div>
          <div>
            <dt class="gl-detail-label">Mobile phone</dt>
            <dd class="gl-detail-value"><%= @customer.cellphone&.number.presence || "Not provided" %></dd>
          </div>
          <div>
            <dt class="gl-detail-label">Home phone</dt>
            <dd class="gl-detail-value"><%= @customer.homephone&.number.presence || "Not provided" %></dd>
          </div>
          <% if @customer.secondary_email&.address.present? %>
            <div>
              <dt class="gl-detail-label">Alternate email</dt>
              <dd class="gl-detail-value gl-detail-value-break"><%= @customer.secondary_email.address %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <section class="gl-detail-card">
        <h2 class="gl-detail-title">Address</h2>
        <dl class="gl-detail-list">
          <div>
            <dt class="gl-detail-label">Mailing address</dt>
            <dd class="gl-detail-value gl-detail-value-address"><%= @customer.address&.mailing.presence || "No address on file" %></dd>
          </div>
          <% if @customer.billing_address.present? && @customer.billing_address != @customer.address %>
            <div>
              <dt class="gl-detail-label">Billing address</dt>
              <dd class="gl-detail-value gl-detail-value-address"><%= @customer.billing_address.mailing %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    </div>
  </div>
</section>
