<%= form_with(model: customer, class: "contents") do |form| %>
  <% if customer.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:</h2>

      <ul class="list-disc ml-6">
        <% customer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :type %>
    <%= form.select :customer_type, Customer.customer_types.keys.map { |key| [ key.humanize, key ]}, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": customer.errors[:first_name].none?, "border-red-400 focus:outline-red-600": customer.errors[:first_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :first_name %>
    <%= form.text_field :first_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": customer.errors[:first_name].none?, "border-red-400 focus:outline-red-600": customer.errors[:first_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :last_name %>
    <%= form.text_field :last_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": customer.errors[:last_name].none?, "border-red-400 focus:outline-red-600": customer.errors[:last_name].any?}] %>
  </div>

  <%= form.fields_for :address do |address_form| %>
    <div class="my-5">
      <%= address_form.label :street %>
      <%= address_form.text_field :street, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= address_form.label :street2 %>
      <%= address_form.text_field :street2, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= address_form.label :city %>
      <%= address_form.text_field :city, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= address_form.label :state %>
      <%= address_form.text_field :state, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= address_form.label :zip %>
      <%= address_form.text_field :zip, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= address_form.label :country %>
      <%= address_form.text_field :country, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <%= form.fields_for :cellphone do |cell_form| %>
    <div class="my-5">
      <%= cell_form.label :number, "Cellphone" %>
      <%= cell_form.text_field :number, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <% if customer.errors[:first_name].include?("and last name already exists") %>
    <%= form.hidden_field :skip_unique_name_validation, value: true %>
    <%= form.submit "Create anyway?", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  <% else %>
    <div class="inline">
      <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
<% end %>
