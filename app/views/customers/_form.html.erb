<% input_classes = "mt-2 block w-full rounded-xl border bg-[rgba(10,14,26,0.55)] px-3.5 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-300/30 focus:shadow-[0_0_30px_rgba(125,211,252,0.05)] focus:outline-none" %>
<% label_classes = "text-sm font-medium text-slate-300" %>

<%= form_with(model: customer, class: "space-y-5") do |form| %>
  <% if customer.errors.any? %>
    <div id="error_explanation" class="rounded-xl border border-rose-300/20 bg-rose-300/10 px-4 py-3 text-sm text-rose-100" role="alert">
      <h2 class="font-semibold"><%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:</h2>

      <ul class="ml-5 mt-2 list-disc space-y-1 text-rose-200">
        <% customer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :customer_type, class: label_classes %>
    <%= form.select :customer_type, Customer.customer_types.keys.map { |key| [ key.humanize, key ] }, {}, class: [input_classes, customer.errors[:customer_type].any? ? "border-rose-300/40" : "border-white/10"] %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :first_name, class: label_classes %>
      <%= form.text_field :first_name, autocomplete: "given-name", class: [input_classes, customer.errors[:first_name].any? ? "border-rose-300/40" : "border-white/10"] %>
    </div>
    <div>
      <%= form.label :last_name, class: label_classes %>
      <%= form.text_field :last_name, autocomplete: "family-name", class: [input_classes, customer.errors[:last_name].any? ? "border-rose-300/40" : "border-white/10"] %>
    </div>
  </div>

  <%= render "customers/form/telephone", form: form, attribute: :cellphone, model: customer.cellphone %>
  <%= render "customers/form/email", form: form, attribute: :email, model: customer.email %>
  <%= render "customers/form/address", form: form, attribute: :address, model: customer.address %>

  <% if customer.errors[:first_name].include?("and last name already exists") %>
    <%= form.hidden_field :skip_unique_name_validation, value: true %>
    <%= form.submit "Create anyway?", class: "w-full cursor-pointer rounded-xl border border-sky-300/15 bg-sky-300/10 px-5 py-3 text-sm font-semibold text-[#7dd3fc] transition-colors hover:bg-sky-300/20 sm:w-auto" %>
  <% else %>
    <div class="flex flex-col-reverse gap-3 border-t border-white/10 pt-5 sm:flex-row sm:justify-end">
      <%= link_to "Cancel", customer.persisted? ? customer_path(customer) : customers_path, class: "rounded-xl border border-white/10 px-5 py-3 text-center text-sm font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white" %>
      <%= form.submit class: "w-full cursor-pointer rounded-xl border border-sky-300/15 bg-sky-300/10 px-5 py-3 text-sm font-semibold text-[#7dd3fc] transition-colors hover:bg-sky-300/20 sm:w-auto" %>
    </div>
  <% end %>
<% end %>
