<% content_for :title, "New customer" %>

<section class="gl-page gl-page-narrow">
  <%= link_to customers_path, class: "gl-link-back" do %>
    <span aria-hidden="true">←</span>
    Customer directory
  <% end %>

  <div>
    <p class="gl-eyebrow">Customer directory / New</p>
    <h1 class="gl-title">Add a customer</h1>
    <p class="gl-subtitle">Create an account and save their contact details.</p>
  </div>

  <div class="gl-form-card">
    <%= render "form", customer: @customer %>
  </div>
</section>
