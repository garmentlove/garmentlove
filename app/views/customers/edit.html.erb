<% content_for :title, "Edit #{@customer.name}" %>

<section class="gl-page gl-page-narrow">
  <%= link_to customer_path(@customer), class: "gl-link-back" do %>
    <span aria-hidden="true">←</span>
    Customer account
  <% end %>

  <div>
    <p class="gl-eyebrow">Customer directory / Edit</p>
    <h1 class="gl-title">Edit customer</h1>
    <p class="gl-subtitle">Update the account and contact information for <%= @customer.name %>.</p>
  </div>

  <div class="gl-form-card">
    <%= render "form", customer: @customer %>
  </div>
</section>
