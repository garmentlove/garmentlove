<%= form.fields_for attribute do |email_form| %>
  <%= email_form.hidden_field :id %> 
  <%= email_form.hidden_field :_destroy %>

  <div>
    <%= email_form.label :address, attribute.to_s.humanize, class: "text-sm font-medium text-slate-300" %>
    <%= email_form.email_field :address, autocomplete: "email", class: ["mt-2 block w-full rounded-xl border bg-[rgba(10,14,26,0.55)] px-3.5 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-300/30 focus:shadow-[0_0_30px_rgba(125,211,252,0.05)] focus:outline-none", model.errors[:address].present? ? "border-rose-300/40" : "border-white/10"] %>
  </div>
<% end %>