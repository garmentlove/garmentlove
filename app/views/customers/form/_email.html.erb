<%= form.fields_for attribute do |email_form| %>
  <%= email_form.hidden_field :id %> 
  <%= email_form.hidden_field :_destroy %>

  <div class="gl-form-field">
    <%= email_form.label :address, attribute.to_s.humanize, class: "gl-form-label" %>
    <%= email_form.email_field :address, autocomplete: "email", class: ["gl-input", model.errors[:address].present? ? "gl-input-error" : nil] %>
  </div>
<% end %>