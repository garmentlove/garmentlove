<%= form.fields_for attribute do |telephone_form| %>
  <%= telephone_form.hidden_field :id %> 
  <%= telephone_form.hidden_field :_destroy %>

  <div class="gl-form-field">
    <%= telephone_form.label :number, attribute.to_s.humanize, class: "gl-form-label" %>
    <%= telephone_form.telephone_field :number, autocomplete: "tel", class: ["gl-input", model.errors[:number].present? ? "gl-input-error" : nil] %>
  </div>
<% end %>