<%= form.fields_for attribute do |address_form| %>
  <%= address_form.hidden_field :id %> 
  <%= address_form.hidden_field :_destroy %>

  <div class="my-5">
    <%= address_form.label :street %>
    <%= address_form.text_field :street, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:street].blank?, "border-red-400 focus:outline-red-600": model.errors[:street].present?}] %>
  </div>
  <div class="my-5">
    <%= address_form.label :street2 %>
    <%= address_form.text_field :street2, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:street2].blank?, "border-red-400 focus:outline-red-600": model.errors[:street2].present?}] %>
  </div>
  <div class="my-5">
    <%= address_form.label :city %>
    <%= address_form.text_field :city, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:city].blank?, "border-red-400 focus:outline-red-600": model.errors[:city].present?}] %>
  </div>
  <div class="my-5">
    <%= address_form.label :state %>
    <%= address_form.text_field :state, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:state].blank?, "border-red-400 focus:outline-red-600": model.errors[:state].present?}] %>
  </div>
  <div class="my-5">
    <%= address_form.label :zip %>
    <%= address_form.text_field :zip, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:zip].blank?, "border-red-400 focus:outline-red-600": model.errors[:zip].present?}] %>
  </div>
  <div class="my-5">
    <%= address_form.label :country %>
    <%= address_form.text_field :country, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": model.errors[:country].blank?, "border-red-400 focus:outline-red-600": model.errors[:country].present?}] %>
  </div>
<% end %>